# Copie ce fichier vers .env pour le développement local.
# Sur le VPS, configure les valeurs de production dans le fichier EnvironmentFile de systemd.

# Clé locale uniquement. Génère une clé différente pour le serveur.
SECRET_KEY=django-insecure-local-only-change-before-deployment
DEBUG=True

# Hôtes autorisés, séparés par des virgules, sans http:// ni https://.
ALLOWED_HOSTS=localhost,127.0.0.1

# Origines autorisées pour les formulaires Django; laisser vide en local.
CSRF_TRUSTED_ORIGINS=

# Laisser vides en local pour utiliser ./db.sqlite3 et ./media.
# Sur le VPS, utiliser par exemple /var/lib/mnrdc/db.sqlite3 et /var/lib/mnrdc/media.
SQLITE_PATH=
MEDIA_ROOT=
